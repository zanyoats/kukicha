# Editor configuration, see http://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = tab

[Makefile]
indent_style = tab
indent_size = tab

[*.md]
trim_trailing_whitespace = false

[*.css]
indent_size = 4
