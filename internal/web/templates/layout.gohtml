{{define "layout"}}
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{block "title" .}}{{end}} - Kukicha</title>
        <link
            rel="icon"
            type="image/svg+xml"
            href="{{.URLs.InstanceIdenticon}}"
        />
        <link rel="stylesheet" href="{{.URLs.UnpolyStylesheet}}" />
        <link rel="stylesheet" href="{{.URLs.Stylesheet}}" />
        <template id="notification-layer-template">
            <section class="toast-layer"
                aria-label="Notifications"
                data-notifications
                data-toast-min-duration-ms="{{toastMinDurationMS}}">
                <template data-toast-template>
                    <div class="toast">
                        <span data-toast-message role="status" aria-atomic="true"></span>
                        <button type="button" class="toast-dismiss" data-toast-dismiss aria-label="Dismiss notification">×</button>
                    </div>
                </template>
            </section>
        </template>
        <script type="module" src="{{.URLs.AppJavaScript}}"></script>
    </head>

    {{block "body" .}}
    <body class="app">
        {{template "svgsprite" .}}

        {{template "header" .}}

        <main id="main-content" class="content-outer-shell" up-main up-viewport>
            <section class="content-inner-shell">
                {{block "page-content" .}}{{end}}
            </section>
        </main>

        {{template "footer" .}}
    </body>
    {{end}}
</html>
{{end}}
