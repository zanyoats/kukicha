{{define "layout"}}
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{block "title" .}}{{end}} - Kukicha</title>
        <link
            rel="icon"
            type="image/svg+xml"
            href="{{.URLs.InstanceIdenticon}}"
        />
        <link rel="stylesheet" href="{{.URLs.UnpolyStylesheet}}" />
        <link rel="stylesheet" href="{{.URLs.Stylesheet}}" />
        <script type="module" src="{{.URLs.AppJavaScript}}"></script>
    </head>

    {{block "body" .}}
    <body class="app">
        {{template "svgsprite" .}}

        {{template "header" .}}

        <main class="content-outer-shell" up-main>
            <section class="content-inner-shell">
                {{block "page-content" .}}{{end}}
            </section>
        </main>

        {{template "footer" .}}
    </body>
    {{end}}
</html>
{{end}}
