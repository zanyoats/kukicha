{{define "footer" -}}
<footer id="player" class="now-playing" style="--player-artwork-size: {{playerArtworkSize}}px;" up-keep>
    <audio data-scrobble-url="{{.URLs.Scrobble}}" data-radio-url="{{.URLs.RadioTrack}}" data-player-audio preload="metadata" crossorigin="anonymous"></audio>

    <section
        class="album-meta"
        role="status"
        aria-live="polite"
        aria-atomic="true"
    >
        <a class="artwork-shell" data-player-album-link up-follow>
            <img data-player-artwork data-artwork-fallback-url="{{.URLs.AlbumArtwork64Fallback}}" alt="" hidden />
        </a>

        <div>
            <a class="album-title text-truncate" data-player-album data-player-album-link up-follow></a>
            <div class="track-artists text-truncate" data-player-artists hidden></div>
            <div class="track-artists text-truncate" data-player-radio hidden></div>
        </div>
    </section>

    <section class="primary-controls" aria-label="Playback controls">
        <button
            class="play-button"
            type="button"
            data-player-action="toggle"
            aria-label="Play"
            disabled
        >
            <svg class="audio-icon" aria-hidden="true">
                <use href="#icon-play" data-player-play-icon></use>
            </svg>
        </button>

        <div class="track-info">
            <div class="track-info-text">
                <div class="track-title text-truncate" data-player-title>Choose a track</div>

                <div class="track-time">
                    <span data-player-current-time>0:00</span>
                    <span aria-hidden="true"> / </span>
                    <span class="visually-hidden">of</span>
                    <span data-player-duration>0:00</span>
                </div>
            </div>

            <input
                class="track-bar range-control"
                type="range"
                min="0"
                max="0"
                value="0"
                step="0.1"
                data-player-seek
                aria-label="Seek through track"
                disabled
            />
        </div>

        <div class="track-buttons">
            <button
                class="icon-button"
                type="button"
                data-player-action="previous"
                aria-label="Previous track"
                disabled
            >
                <svg class="audio-icon" aria-hidden="true">
                    <use href="#icon-previous"></use>
                </svg>
            </button>

            <button
                class="icon-button"
                type="button"
                data-player-action="next"
                aria-label="Next track"
                disabled
            >
                <svg class="audio-icon" aria-hidden="true">
                    <use href="#icon-next"></use>
                </svg>
            </button>
        </div>
    </section>

    <section class="secondary-controls" aria-label="Player options">
        <button
            class="icon-button"
            type="button"
            aria-label="Open queue"
            aria-expanded="false"
            aria-controls="player-queue-panel"
            data-player-action="queue"
            up-follow
            up-class="player-queue-drawer"
            up-dismissible="key outside"
            up-layer="new drawer"
            up-position="right"
            up-animation="player-queue-from-footer"
            up-close-animation="player-queue-to-footer"
            up-content="#player-queue-panel-template"
        >
            <svg class="audio-icon" aria-hidden="true">
                <use href="#icon-queue"></use>
            </svg>
        </button>

        <button
            class="icon-button"
            type="button"
            data-player-action="mute"
            aria-label="Mute"
        >
            <svg class="audio-icon" aria-hidden="true">
                <use href="#icon-volume" data-player-volume-icon></use>
            </svg>
        </button>

        <input
            class="volume-bar range-control"
            type="range"
            min="0"
            max="1"
            value="1"
            step="0.01"
            data-player-volume
            aria-label="Volume"
        />
    </section>
</footer>

<template id="player-queue-panel-template">
    <aside
        id="player-queue-panel"
        class="player-queue-panel"
        role="dialog"
        aria-modal="true"
        aria-label="Queue"
        data-player-queue-panel
    >
        <p data-player-queue-empty>No tracks queued.</p>

        <ol data-player-queue-items hidden></ol>
    </aside>
</template>
{{end}}
