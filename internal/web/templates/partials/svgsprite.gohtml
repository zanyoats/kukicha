{{define "svgsprite" -}}
<svg class="icon-sprite" aria-hidden="true">
    <symbol id="icon-play" viewBox="0 0 24 24">
        <path fill="currentColor" d="M8 5v14l11-7z"></path>
    </symbol>

    <symbol id="icon-pause" viewBox="0 0 24 24">
        <path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z"></path>
    </symbol>

    <symbol id="icon-previous" viewBox="0 0 24 24">
        <path fill="currentColor" d="M6 6h3v12H6zm3.5 6 8.5 6V6z"></path>
    </symbol>

    <symbol id="icon-next" viewBox="0 0 24 24">
        <path fill="currentColor" d="m6 18 8.5-6L6 6zm9-12v12h3V6z"></path>
    </symbol>

    <symbol id="icon-volume" viewBox="0 0 24 24">
        <path
            fill="currentColor"
            d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4.03v8.05A4.48 4.48 0 0 0 16.5 12zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06A9 9 0 0 0 14 3.23z"
        ></path>
    </symbol>

    <symbol id="icon-volume-off" viewBox="0 0 24 24">
        <path
            fill="currentColor"
            d="M3 9v6h4l5 5V4L7 9H3zm13.59 3L14 14.59 15.41 16 18 13.41 20.59 16 22 14.59 19.41 12 22 9.41 20.59 8 18 10.59 15.41 8 14 9.41z"
        ></path>
    </symbol>

    <symbol id="icon-playlist" viewBox="0 0 24 24">
        <path
            fill="currentColor"
            d="M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18A3 3 0 1 0 19 17V8h3V6h-5z"
        ></path>
    </symbol>

    <symbol id="icon-track-actions" viewBox="0 0 24 24">
        <circle cx="12" cy="5" r="2" fill="currentColor"></circle>
        <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
        <circle cx="12" cy="19" r="2" fill="currentColor"></circle>
    </symbol>
</svg>
{{ end }}
