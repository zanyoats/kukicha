{{define "header" -}}
<header class="top-nav">
    <nav aria-label="Primary navigation" up-nav>
        <a href="{{.HomeURL}}" up-follow>home</a>
        <a href="{{.LibraryURL}}" up-alias="{{.LibraryURL}}/*" up-follow
            >library</a
        >
        <a href="{{.SearchURL}}" up-follow>search</a>
    </nav>

    <a
        class="avatar"
        aria-label="Open avatar panel"
        up-class="avatar-drawer"
        up-layer="new drawer"
        up-position="right"
        up-content="#avatar-panel-template"
    >
        <img src="{{.InstanceIdenticonURL}}" alt="Kukicha instance identicon" />
    </a>
</header>

<template id="avatar-panel-template">
    <aside class="avatar-panel" aria-label="Avatar panel">
        <h2>
            <a
                href="{{.HomeURL}}/roots"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >Roots</a
            >
        </h2>
        <h2>
            <a
                href="{{.HomeURL}}/artistSplitRules"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >Artist Split Rules</a
            >
        </h2>
        <h2>
            <a
                href="{{.HomeURL}}/metadataOverrides"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >Metadata Overrides</a
            >
        </h2>
        <h2>
            <a
                href="{{.HomeURL}}/listeningData"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >Listening Data</a
            >
        </h2>
        <h2>
            <a
                href="{{.HomeURL}}/cache"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >Cache</a
            >
        </h2>
        <h2>
            <a
                href="{{.HomeURL}}/jobs"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >Jobs</a
            >
        </h2>
        <h2>
            <a
                href="{{.HomeURL}}/help"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >Help</a
            >
        </h2>
    </aside>
</template>
{{end}}
