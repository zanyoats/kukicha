{{define "header" -}}
<header class="top-nav">
    <nav aria-label="Primary navigation" up-nav>
        <a href="{{.HomeURL}}" up-follow>home</a>
        <a href="{{.LibraryURL}}" up-alias="{{.LibraryURL}}/*" up-follow
            >library</a
        >
        <a href="{{.SearchURL}}" up-follow>search</a>
    </nav>

    <a
        class="avatar"
        aria-label="Open avatar panel"
        up-class="avatar-drawer"
        up-layer="new drawer"
        up-position="right"
        up-content="#avatar-panel-template"
    >
        <img src="{{.InstanceIdenticonURL}}" alt="Kukicha instance identicon" />
    </a>
</header>

<template id="avatar-panel-template">
    <aside class="avatar-panel" aria-label="Avatar panel">
        {{range .ConfigLinks}}
        <h2>
            <a
                href="{{.URL}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="true"
                up-animation="false"
                up-close-animation="false"
                >{{.Title}}</a
            >
        </h2>
        {{end}}
    </aside>
</template>
{{end}}
