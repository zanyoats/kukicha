{{define "header" -}}
<div>
    <section class="snackbar"
        aria-label="Current job"
        data-job-snackbar
        data-job-events="{{.URLs.JobEvents}}"
        data-job-cancel-url="{{.URLs.CancelJob}}"
        data-collapsed inert>
        <div class="snackbar-clip">
            <div class="snackbar-content">
                <span data-job-description role="status" aria-live="polite" aria-atomic="true"></span>
                <button type="button" class="inline-action snackbar-action" data-job-cancel disabled>Cancel</button>
            </div>
        </div>
        <template data-job-labels>
            <span data-type="build">Build library</span>
        </template>
    </section>
    <header class="top-nav">
        <nav aria-label="Primary navigation" up-nav>
            <a href="{{.URLs.Home}}" up-follow>home</a>
            <a href="{{.URLs.Library}}" up-alias="{{.URLs.Library}}*" up-follow
                >library</a
            >
            <a href="{{.URLs.Search}}" up-follow>search</a>
        </nav>

        <button
            type="button"
            class="avatar"
            aria-haspopup="dialog"
            up-follow
            aria-label="Open avatar panel"
            up-class="avatar-drawer"
            up-layer="new drawer"
            up-position="right"
            up-content="#avatar-panel-template"
        >
            <img src="{{.URLs.InstanceIdenticon}}" alt="Kukicha instance identicon" />
        </button>
    </header>
</div>

<template id="avatar-panel-template">
    <aside class="avatar-panel" aria-label="Avatar panel">
        <h2>
            <a
                href="{{.URLs.Roots}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Storage</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.ArtistRules}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Artist Rules</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.MetadataOverrides}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Metadata Overrides</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.ListeningData}}" data-listening-link
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Listening Data</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Jobs}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Jobs</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Help}}"
                up-cache="false"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Help</a
            >
        </h2>
        <div class="avatar-actions">
            <form method="post" action="{{.URLs.Logout}}" up-submit>
                <button type="submit" class="action-button">Log out</button>
            </form>
        </div>
    </aside>
</template>
{{end}}
