{{define "header" -}}
<header class="top-nav">
    <nav aria-label="Primary navigation" up-nav>
        <a href="{{.URLs.Home}}" up-follow>home</a>
        <a href="{{.URLs.Library}}" up-alias="{{.URLs.Library}}*" up-follow
            >library</a
        >
        <a href="{{.URLs.Search}}" up-follow>search</a>
    </nav>

    <a
        class="avatar"
        aria-label="Open avatar panel"
        up-class="avatar-drawer"
        up-layer="new drawer"
        up-position="right"
        up-content="#avatar-panel-template"
    >
        <img src="{{.URLs.InstanceIdenticon}}" alt="Kukicha instance identicon" />
    </a>
</header>

<template id="avatar-panel-template">
    <aside class="avatar-panel" aria-label="Avatar panel">
        <h2>
            <a
                href="{{.URLs.Roots}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Roots</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.ArtistSplitRules}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Artist Split Rules</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.MetadataOverrides}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Metadata Overrides</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.ListeningData}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Listening Data</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Cache}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Cache</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Jobs}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Jobs</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Help}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Help</a
            >
        </h2>
    </aside>
</template>
{{end}}
