{{define "header" -}}
<header class="top-nav">
    <nav aria-label="Primary navigation" up-nav>
        <a href="{{.URLs.Home}}" up-follow>home</a>
        <a href="{{.URLs.Library}}" up-alias="{{.URLs.Library}}*" up-follow
            >library</a
        >
        <a href="{{.URLs.Search}}" up-follow>search</a>
    </nav>

    <a
        class="avatar"
        aria-label="Open avatar panel"
        up-class="avatar-drawer"
        up-layer="new drawer"
        up-position="right"
        up-content="#avatar-panel-template"
    >
        <img src="{{.URLs.InstanceIdenticon}}" alt="Kukicha instance identicon" />
    </a>

    <section class="notification-layer"
        aria-label="Notifications"
        data-notifications
        data-toast-min-duration-ms="{{toastMinDurationMS}}"
        data-job-events="{{.URLs.JobEvents}}"
        data-job-cancel-url="{{.URLs.CancelJob}}">
        <div class="notification snackbar" data-job-snackbar hidden>
            <span data-job-description role="status" aria-live="polite" aria-atomic="true"></span>
            <a href="{{.URLs.CancelJob}}" class="notification-action" data-job-cancel up-follow="false">Cancel</a>
        </div>
        <template data-toast-template>
            <div class="notification toast">
                <span data-toast-message role="status" aria-atomic="true"></span>
                <button type="button" class="notification-dismiss" data-toast-dismiss aria-label="Dismiss notification">×</button>
            </div>
        </template>
        <template data-job-labels>
            <span data-type="sync">Sync library</span>
            <span data-type="scan">Scan library</span>
        </template>
    </section>
</header>

<template id="avatar-panel-template">
    <aside class="avatar-panel" aria-label="Avatar panel">
        <h2>
            <a
                href="{{.URLs.Roots}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Roots</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.ArtistSplitRules}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Artist Split Rules</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.MetadataOverrides}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Metadata Overrides</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.ListeningData}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Listening Data</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Cache}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Cache</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Jobs}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Jobs</a
            >
        </h2>
        <h2>
            <a
                href="{{.URLs.Help}}"
                up-layer="new modal"
                up-target=".config-page"
                up-class="config-modal"
                up-history="false"
                up-animation="false"
                up-close-animation="false"
                >Help</a
            >
        </h2>
    </aside>
</template>
{{end}}
