{{define "job-help-trigger" -}}
<button
    type="button"
    class="info-trigger"
    aria-label="When to run {{.}}"
    aria-haspopup="dialog"
    up-follow
    up-layer="new popup"
    up-content="#job-help-{{.}}"
    up-class="info-popup"
    up-position="bottom"
    up-align="left"
    up-history="false"
    up-dismissible="key outside"
><span aria-hidden="true">[?]</span></button>
{{- end}}

{{define "rebuild-job-help"}}
    <template id="job-help-rebuild">
        <section class="job-help" aria-labelledby="job-help-rebuild-title">
            <h2 id="job-help-rebuild-title">When to run Rebuild</h2>
            <p>Refresh how your music is organized using saved metadata and corrections. Your music files are not read or downloaded again. Metadata Overrides may fetch external metadata or artwork that is not already cached.</p>
            <ul>
                <li>After saving an album and artists for Unrecognized Tracks. Tracks marked Ready for rebuild will be added to your library; tracks still needing identification will remain on that page.</li>
                <li>After saving or removing Artist Rules.</li>
                <li>After saving or removing Metadata Overrides.</li>
                <li>After changing how genres or styles are grouped or recognized through these configuration settings:
                    <ul>
                        <li><code>scan.primary_genre_split_tokens</code></li>
                        <li><code>scan.secondary_genre_split_tokens</code></li>
                        <li><code>scan.genre_style_aliases</code></li>
                    </ul>
                </li>
                <li>After a new taxonomy version has loaded successfully, as shown in the startup logs.</li>
            </ul>
            <p class="job-help-note"><strong>Adding new music?</strong> Use Add to Kukicha to import it. Rebuild does not discover or import new files.</p>
        </section>
    </template>
{{end}}
