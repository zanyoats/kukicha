{{define "import-form"}}
    <form class="add-form" action="{{.URLs.Add}}" method="post" data-add-form data-max-request-bytes="{{.MaxRequestBytes}}" up-submit="false">
        <div class="root-form-heading">
            <h2>Import into {{.ImportID}}</h2>
            <a href="{{.URLs.Roots}}" up-target=".config-page" up-history="false" data-add-cancel>Cancel</a>
        </div>
        <input type="hidden" name="root_config_id" value="{{.ImportID}}">
        <div class="add-destination">
            <label for="add-mode">Add from (required)</label>
            <select id="add-mode" name="mode" required>
                {{range .Modes}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
            </select>
        </div>
        <div class="add-source-fields" data-add-panel="files">
            <p class="text-secondary" id="add-upload-limit">Upload limit: {{.UploadLimit}} per request, including multipart headers. Leave some room below the limit, or upload in smaller batches.</p>
            <p class="alert alert-error" data-add-size-error role="alert" hidden></p>
            <div class="add-dropzone" data-add-dropzone>
                <p>Files (required) — drop files or folders here</p>
                <p class="alert alert-error" id="add-files-error" data-add-files-error role="alert" hidden>Choose at least one file or a folder containing files.</p>
                <div class="add-actions">
                    <button type="button" class="action-button" data-add-pick-files aria-describedby="add-files-error">Choose files</button>
                    <button type="button" class="action-button" data-add-pick-folder>Choose folder</button>
                </div>
                <p class="text-secondary">All file types are accepted. Folders include files from all subfolders. ZIP, TAR, gzip-compressed TAR, and bzip2-compressed TAR archives are extracted.</p>
                <input type="file" data-add-files multiple hidden>
                <input type="file" data-add-folder webkitdirectory multiple hidden>
            </div>
            <p class="text-secondary" data-add-status role="status" aria-live="polite">No files selected.</p>
            <ul class="add-files" data-add-list aria-label="Selected files" hidden></ul>
        </div>
        <div class="add-source-fields" data-add-panel="sync" hidden>
            <div class="add-destination">
                <label for="add-source-type">Source (required)</label>
                <select id="add-source-type" name="source_type" required disabled>
                    <option value="folder">Server folder</option>
                    <option value="remote">S3-compatible bucket</option>
                </select>
            </div>
            <div class="add-source-fields" data-add-source="folder">
                <div class="add-destination">
                    <label for="add-folder">Server folder path (required)</label>
                    <input id="add-folder" name="folder" type="text" placeholder="/path/to/music" required disabled>
                    <p class="text-secondary">An absolute folder path on the server running Kukicha.</p>
                </div>
            </div>
            <div class="add-source-fields" data-add-source="remote" hidden>
                <div class="add-destination">
                    <label for="add-endpoint">Bucket endpoint (required)</label>
                    <input id="add-endpoint" name="endpoint_url" type="url" placeholder="https://s3.example.com" required disabled>
                </div>
                <div class="add-destination">
                    <label for="add-bucket">Bucket (required)</label>
                    <input id="add-bucket" name="bucket" type="text" required disabled>
                </div>
                <div class="add-destination">
                    <label for="add-prefix">Prefix (optional)</label>
                    <input id="add-prefix" name="prefix" type="text" placeholder="music/" disabled>
                    <p class="text-secondary">Use a trailing slash for a folder tree. Leave empty to scan the whole bucket.</p>
                </div>
                <div class="add-destination">
                    <label for="add-region">Region (required)</label>
                    <input id="add-region" name="region" type="text" placeholder="us-east-1" required disabled>
                </div>
                <div class="add-destination">
                    <label for="add-addressing">Addressing style (optional)</label>
                    <select id="add-addressing" name="addressing_style" disabled>
                        <option value="auto">Auto</option>
                        <option value="path">Path</option>
                        <option value="virtual">Virtual host</option>
                    </select>
                </div>
                <p class="action-with-info"><strong>Temporary access credentials</strong><button type="button" class="info-trigger"
                    aria-label="How to get temporary access credentials" aria-haspopup="dialog" up-follow
                    up-layer="new popup" up-content="#source-credentials-help" up-class="info-popup"
                    up-position="bottom" up-align="left" up-history="false" up-dismissible="key outside"
                    disabled><span aria-hidden="true">[?]</span></button></p>
                <div class="add-destination">
                    <label for="add-access-key">AccessKeyId (required)</label>
                    <input id="add-access-key" name="access_key_id" type="password" autocomplete="off" spellcheck="false" required disabled>
                </div>
                <div class="add-destination">
                    <label for="add-secret-key">SecretAccessKey (required)</label>
                    <input id="add-secret-key" name="secret_access_key" type="password" autocomplete="off" spellcheck="false" required disabled>
                </div>
                <div class="add-destination">
                    <label for="add-session-token">SessionToken (required)</label>
                    <input id="add-session-token" name="session_token" type="password" autocomplete="off" spellcheck="false" required disabled>
                </div>
                <p class="text-secondary">Used only to read this source. Kukicha won’t use the server’s credentials for it. Choose credentials that will remain valid while the job waits and runs.</p>
            </div>
            <p class="text-secondary">The build job scans and copies music into the selected storage location. Source files remain unchanged.</p>
        </div>
        <p class="text-secondary" data-add-notice role="status" hidden></p>
        <div class="add-actions">
            <button type="button" class="action-button" data-add-clear disabled>Clear files</button>
            <button type="submit" class="action-button" data-add-upload>Upload</button>
            <span class="text-secondary" data-add-progress hidden title="Bytes sent, including multipart headers. The server may still be processing the upload."></span>
        </div>
    </form>
    <template id="source-credentials-help">
        <section class="job-help" aria-labelledby="source-credentials-help-title">
            <h2 id="source-credentials-help-title">Get temporary credentials</h2>
            <p>Run this on your computer using your provider’s documented <strong>STS endpoint</strong> and your AWS CLI profile:</p>
            <pre><code>aws sts get-session-token \
  --duration-seconds 3600 \
  --endpoint-url https://sts.wasabisys.com \
  --profile your-profile \
  --no-cli-pager</code></pre>
            <p>This example uses Wasabi’s STS endpoint. Replace it for your provider. For AWS, omit <code>--endpoint-url</code>.</p>
            <p>Paste <code>AccessKeyId</code>, <code>SecretAccessKey</code>, and <code>SessionToken</code> from the response into the form. Your profile needs permission to list the source bucket and read its files. Add MFA parameters if your account requires them.</p>
            <p class="job-help-note"><strong>Bucket endpoint is different:</strong> enter your provider’s S3 storage endpoint in the form, not its STS endpoint. Make sure the credentials remain valid long enough for the import to finish.</p>
        </section>
    </template>
{{end}}
