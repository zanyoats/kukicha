{{define "title"}}{{.Album.Title}}{{ end }}

{{define "page-content"}}
<article class="album-page" data-player-queue up-data="{{.PlayerQueueData}}">
    <header class="album-header">
        <img
            class="album-artwork"
            src="{{.AlbumArtworkURL}}"
            alt="Artwork for {{.Album.Title}}"
            data-player-album-artwork
        />

        <div class="album-summary">
            <h1 class="album-title" data-player-album-title>
                {{.Album.Title}}
            </h1>

            {{ with.Album.Artists }}
            <p class="album-artists" data-player-album-artists-source>
                {{range $index, $artist := .}}
                {{if $index}}, {{ end }}{{ $artist }}
                {{ end }}
            </p>
            {{ end }}

            <dl class="album-facts">
                {{ with.Album.ReleaseDate }}
                <div>
                    <dt>Released</dt>
                    <dd>{{.}}</dd>
                </div>
                {{else}}
                {{ with.Album.ReleaseYear }}
                <div>
                    <dt>Released</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}
                {{ end }}

                {{ with.Album.OriginalReleaseDate }}
                <div>
                    <dt>Original release</dt>
                    <dd>{{.}}</dd>
                </div>
                {{else}}
                {{ with.Album.OriginalReleaseYear }}
                <div>
                    <dt>Original release</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}
                {{ end }}

                {{ with.Album.ReleaseCountry }}
                <div>
                    <dt>Release country</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}

                {{ with.Album.Label }}
                <div>
                    <dt>Label</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}

                {{ with.Album.Composer }}
                <div>
                    <dt>Composer</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}

                {{ with.Album.PurchaseDate }}
                <div>
                    <dt>Purchased</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}

                {{ with.Album.Format }}
                <div>
                    <dt>Format</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}

                {{ with.Album.IsCompilation }}
                <div>
                    <dt>Compilation</dt>
                    <dd>{{yesNo .}}</dd>
                </div>
                {{ end }}

                {{ with.Album.DiscCount }}
                <div>
                    <dt>Discs</dt>
                    <dd>{{.}}</dd>
                </div>
                {{ end }}

                <div>
                    <dt>Tracks</dt>
                    <dd>{{len .Album.Tracks}}</dd>
                </div>

                <div>
                    <dt>Duration</dt>
                    <dd>{{formatDuration .Album.DurationSeconds}}</dd>
                </div>
            </dl>
        </div>
    </header>

    <ol class="track-list">
        {{range $index, $track := .Album.Tracks}}
        <li class="track-row" data-track-id="{{.ID}}">
            <button
                class="inline-play-button"
                type="button"
                data-player-action="play"
                data-track-index="{{ $index }}"
                aria-label="Play {{.Title}}"
                aria-pressed="false"
            >
                <svg class="audio-icon" aria-hidden="true">
                    <use href="#icon-play" data-track-play-icon></use>
                </svg>
            </button>

            <span class="track-position">
                {{ with.TrackNumber }}
                {{.}}
                {{else}}
                —
                {{ end }}
            </span>

            <span class="track-info">
                <span class="track-title">
                    {{.Title}}
                </span>

                {{ with.Artists }}
                <p class="track-artists">
                    {{range $index, $artist := .}}{{if $index}}, {{ end
                    }}{{ $artist }}{{ end }}
                </p>
                {{ end }}
            </span>

            <span
                class="track-duration"
                data-track-duration
                aria-label="Duration {{formatDuration .DurationSeconds}}"
                >{{formatDuration .DurationSeconds}}</span
            >

            <button
                class="icon-button"
                type="button"
                aria-label="Track actions for {{.Title}}"
            >
                <svg class="audio-icon" aria-hidden="true">
                    <use href="#icon-track-actions"></use>
                </svg>
            </button>
        </li>
        {{else}}
        <li class="track-list-empty">This album has no tracks.</li>
        {{
            end
        }}
    </ol>

    {{ with.Album.Copyright }}
    <p class="album-copyright">{{.}}</p>
    {{ end }}
</article>
{{ end }}
