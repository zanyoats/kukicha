{{define "title"}}{{.Album.Title}}{{end}}

{{define "page-content"}}
<article class="album-page" data-album-page up-data="{{.AlbumPageData}}">
    {{template "page-header" .}}

    <div class="album-header">
        <img
            class="album-artwork"
            src="{{.LargeArtwork.URL}}"
            alt="Artwork for {{.Album.Title}}"
            width="{{.LargeArtwork.Width}}"
            height="{{.LargeArtwork.Height}}"
        />

        <dl class="facts">
            {{with .Album.Artists}}
            <div>
                <dt>Album artists</dt>
                <dd class="fact-links">
                    {{range .}}
                    <a href="{{$.URLs.ArtistURL .ID}}" up-follow>{{.Name}}</a>
                    {{end}}
                </dd>
            </div>
            {{end}}

            {{with .Album.ReleaseDate}}
            <div>
                <dt>Released</dt>
                <dd>{{formatDate .}}</dd>
            </div>
            {{else}}
            {{with .Album.ReleaseYear}}
            <div>
                <dt>Released</dt>
                <dd>{{.}}</dd>
            </div>
            {{end}}
            {{end}}

            {{with .Album.OriginalReleaseDate}}
            <div>
                <dt>Original release</dt>
                <dd>{{formatDate .}}</dd>
            </div>
            {{else}}
            {{with .Album.OriginalReleaseYear}}
            <div>
                <dt>Original release</dt>
                <dd>{{.}}</dd>
            </div>
            {{end}}
            {{end}}

            {{with .Album.ReleaseCountry}}
            <div>
                <dt>Release country</dt>
                <dd>{{.}}</dd>
            </div>
            {{end}}

            {{with .Album.Label}}
            <div>
                <dt>Label</dt>
                <dd>{{.}}</dd>
            </div>
            {{end}}

            {{with .Album.Composer}}
            <div>
                <dt>Composer</dt>
                <dd>{{.}}</dd>
            </div>
            {{end}}

            {{with .Album.PurchaseDate}}
            <div>
                <dt>Purchased</dt>
                <dd>{{formatDate .}}</dd>
            </div>
            {{end}}

            {{with .Album.Format}}
            <div>
                <dt>Format</dt>
                <dd>{{.}}</dd>
            </div>
            {{end}}

            {{with .Album.IsCompilation}}
            <div>
                <dt>Compilation</dt>
                <dd>{{yesNo .}}</dd>
            </div>
            {{end}}

            {{with .Album.DiscCount}}
            <div>
                <dt>Discs</dt>
                <dd>{{.}}</dd>
            </div>
            {{end}}

            <div>
                <dt>Tracks</dt>
                <dd>{{len .Album.Tracks}}</dd>
            </div>

            <div>
                <dt>Duration</dt>
                <dd>{{formatDuration .Album.DurationSeconds}}</dd>
            </div>

            {{with .Genres}}
            <div>
                <dt>Genres</dt>
                <dd class="fact-links">
                    {{range .}}
                    <a href="{{.URL}}" up-follow>{{.Name}}</a>
                    {{end}}
                </dd>
            </div>
            {{end}}

            {{with .Styles}}
            <div>
                <dt>Styles</dt>
                <dd class="fact-links">
                    {{range .}}
                    <a href="{{.URL}}" up-follow>{{.Name}}</a>
                    {{end}}
                </dd>
            </div>
            {{end}}
        </dl>
    </div>

    <ol class="track-list">
        {{range $index, $track := .Album.Tracks}}
        <li class="track-row" data-track-id="{{.ID}}">
            <button
                class="inline-play-button"
                type="button"
                data-player-action="play"
                data-track-index="{{$index}}"
                aria-label="Play {{.Title}}"
                aria-pressed="false"
            >
                <svg class="audio-icon" aria-hidden="true">
                    <use href="#icon-play" data-track-play-icon></use>
                </svg>
            </button>

            <span class="track-position">
                {{with .TrackNumber}}
                {{.}}
                {{else}}
                —
                {{end}}
            </span>

            <span class="track-info">
                <span class="track-title text-truncate">
                    {{.Title}}
                </span>

                {{with .Artists}}
                <p class="track-artists text-truncate">
                    {{range $index, $artist := .}}{{if $index}}, {{end}}{{$artist}}{{end}}
                </p>
                {{end}}
            </span>

            <span
                class="track-duration"
                data-track-duration
                aria-label="Duration {{formatDuration .DurationSeconds}}"
                >{{formatDuration .DurationSeconds}}</span
            >

            <button
                class="icon-button"
                type="button"
                aria-label="Track actions for {{.Title}}"
            >
                <svg class="audio-icon" aria-hidden="true">
                    <use href="#icon-track-actions"></use>
                </svg>
            </button>
        </li>
        {{else}}
        <li class="track-list-empty">This album has no tracks.</li>
        {{end}}
    </ol>

    {{with .Album.Copyright}}
    <p class="album-copyright">{{.}}</p>
    {{end}}
</article>
{{end}}
