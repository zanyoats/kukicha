{{define "title"}}Home{{end}}

{{define "page-content"}}
<article class="home-page">
    {{template "page-header" .}}

    <section>
        <h2>Artists</h2>
        <ul class="item-grid">
            {{range .Artists}}
            <li class="radio-card">
                <a
                    class="radio-card-name text-truncate"
                    href="{{.URL}}"
                    title="{{.Name}}"
                    up-follow
                    >{{.Name}}</a
                >
                <span class="radio-card-leader" aria-hidden="true"></span>
                <a class="radio-card-link" href="" up-follow>(radio)</a>
            </li>
            {{else}}
            <li class="item-grid-empty">No artist found.</li>
            {{end}}
        </ul>
    </section>

    <section>
        <h2>Genres</h2>
        <ul class="item-grid">
            {{range .Genres}}
            <li class="radio-card">
                <a
                    class="radio-card-name text-truncate"
                    href="{{.URL}}"
                    title="{{.Name}}"
                    up-follow
                    >{{.Name}}</a
                >
                <span class="radio-card-leader" aria-hidden="true"></span>
                <a class="radio-card-link" href="" up-follow>(radio)</a>
            </li>
            {{else}}
            <li class="item-grid-empty">No genres found.</li>
            {{end}}
        </ul>
    </section>

    <section>
        <h2>Styles</h2>
        <ul class="item-grid">
            {{range .Styles}}
            <li class="radio-card">
                <a
                    class="radio-card-name text-truncate"
                    href="{{.URL}}"
                    title="{{.Name}}"
                    up-follow
                    >{{.Name}}</a
                >
                <span class="radio-card-leader" aria-hidden="true"></span>
                <a class="radio-card-link" href="" up-follow>(radio)</a>
            </li>
            {{else}}
            <li class="item-grid-empty">No styles found.</li>
            {{end}}
        </ul>
    </section>
</article>
{{end}}
