{{define "title"}}Home{{end}}

{{define "page-content"}}
<article class="home-page">
    {{template "page-header" .}}

    {{if .HasConfiguredRoots}}
        {{if .LibraryGenerated}}
            {{if .LibraryHasTracks}}
            {{template "home-content" .}}
            {{else}}
            <aside class="alert alert-info" aria-label="Empty library">
                <strong>No tracks were found in any of the below root(s):</strong>
                <ul>
                    {{range .ConfiguredRoots}}
                    <li>
                        <code>{{.Label}}</code>
                        {{if .Remote}}(remote){{end}}
                    </li>
                    {{end}}
                </ul>
                <p>
                    The recognized audio file extensions are:
                    {{range $index, $extension := .RecognizedAudioExtensions}}{{if $index}}, {{end}}<code>{{$extension}}</code>{{end}}.
                </p>
                <p>Check your files and sync again, or add root with recognizable audio files.</p>
            </aside>
            {{end}}
        {{else}}
        <aside class="alert {{if eq .InitialSyncState "failed"}}alert-error{{else if eq .InitialSyncState "canceled"}}alert-warning{{else}}alert-info{{end}}" aria-label="Library preparation">
            {{if eq .InitialSyncState "queued"}}
            <strong>Your library is waiting to be prepared.</strong>
            <p>A sync is queued and will start automatically. Refresh this page after it finishes to view your library.</p>
            {{else if eq .InitialSyncState "running"}}
            <strong>Your library is being prepared.</strong>
            <p>Refresh this page after the sync finishes to view your library.</p>
            {{else if eq .InitialSyncState "failed"}}
            <strong>Your library couldn’t be prepared.</strong>
            <p>The sync failed. Check the job logs for details.</p>
            {{else if eq .InitialSyncState "canceled"}}
            <strong>Library preparation was canceled.</strong>
            <p>Your library hasn’t been generated yet.</p>
            {{else}}
            <strong>Your library hasn’t been prepared yet.</strong>
            <p>No sync is currently queued or running.</p>
            {{end}}
            <p><a href="{{.URLs.Jobs}}" up-layer="new modal" up-target=".config-page" up-class="config-modal" up-history="false">View jobs</a></p>
        </aside>
        {{end}}
    {{else}}
        <aside class="alert alert-info" aria-label="No configured roots">
            <strong>No music roots are configured.</strong>
            {{template "home-configure-roots" .}}
        </aside>
    {{end}}
</article>
{{end}}

{{define "home-configure-roots"}}
<p>
    Configure music roots using the below config file, then restart the app.
    Your library will sync automatically.
</p>
<pre><code>{{.ConfigFilePath}}</code></pre>
<p>
    You can start with a minimal config like this:
</p>
<pre><code>[[scan.roots]]
type = "local"   # support for local and remote roots
id = "itunes"    # any unique id that identifies your root
path = "~/Music" # local dir/folder path for this root</code></pre>
<p>
    Replace the above example with that which makes sense for your configuration.
    To include multiple folders, add a new <code>[[scan.roots]]</code> section.
</p>
{{end}}

{{define "home-content"}}
<section>
    <h2>Artists</h2>
    <ul class="item-grid">
        {{range .Artists}}
        <li class="radio-card">
            <a
                class="radio-card-name text-truncate"
                href="{{.URL}}"
                title="{{.Name}}"
                up-follow
                >{{.Name}}</a
            >
            <span class="radio-card-leader" aria-hidden="true"></span>
            <span class="radio-card-action"{{if not .RadioViable}} title="{{.RadioUnavailableReason}}" tabindex="0" aria-label="{{.Name}} radio: {{.RadioUnavailableReason}}"{{end}}>
                <button type="button" class="radio-card-link" data-radio-kind="artist" data-radio-id="{{.ID}}" aria-label="Play {{.Name}} radio"{{if not .RadioViable}} disabled title="{{.RadioUnavailableReason}}"{{end}}>(radio)</button>
            </span>
        </li>
        {{else}}
        <li class="item-grid-empty">No artist found.</li>
        {{end}}
    </ul>
</section>

<section>
    <h2>Genres</h2>
    <ul class="item-grid">
        {{range .Genres}}
        <li class="radio-card">
            <a
                class="radio-card-name text-truncate"
                href="{{.URL}}"
                title="{{.Name}}"
                up-follow
                >{{.Name}}</a
            >
            <span class="radio-card-leader" aria-hidden="true"></span>
            <span class="radio-card-action"{{if not .RadioViable}} title="{{.RadioUnavailableReason}}" tabindex="0" aria-label="{{.Name}} radio: {{.RadioUnavailableReason}}"{{end}}>
                <button type="button" class="radio-card-link" data-radio-kind="genre" data-radio-id="{{.ID}}" aria-label="Play {{.Name}} radio"{{if not .RadioViable}} disabled title="{{.RadioUnavailableReason}}"{{end}}>(radio)</button>
            </span>
        </li>
        {{else}}
        <li class="item-grid-empty">No genres found.</li>
        {{end}}
    </ul>
</section>

<section>
    <h2>Styles</h2>
    <ul class="item-grid">
        {{range .Styles}}
        <li class="radio-card">
            <a
                class="radio-card-name text-truncate"
                href="{{.URL}}"
                title="{{.Name}}"
                up-follow
                >{{.Name}}</a
            >
            <span class="radio-card-leader" aria-hidden="true"></span>
            <span class="radio-card-action"{{if not .RadioViable}} title="{{.RadioUnavailableReason}}" tabindex="0" aria-label="{{.Name}} radio: {{.RadioUnavailableReason}}"{{end}}>
                <button type="button" class="radio-card-link" data-radio-kind="style" data-radio-id="{{.ID}}" aria-label="Play {{.Name}} radio"{{if not .RadioViable}} disabled title="{{.RadioUnavailableReason}}"{{end}}>(radio)</button>
            </span>
        </li>
        {{else}}
        <li class="item-grid-empty">No styles found.</li>
        {{end}}
    </ul>
</section>
{{end}}
