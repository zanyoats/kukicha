{{define "layout"}}
<section id="listening-genres" aria-label="Monthly plays by genre">
    <h2>Plays by genre</h2>
    {{if .Error}}
    <div class="listening-canvas listening-genres-canvas">
        <p role="alert">{{.Error}}</p>
        <a href="{{.GenresURL}}" up-target="#listening-genres" up-history="false">Retry</a>
    </div>
    {{else}}
    <div class="listening-canvas listening-genres-canvas" data-listening-genres up-data="{{.ChartData}}" aria-busy="true">
        <p class="listening-chart-loading" role="status">Loading chart…</p>
        {{if not .Genres}}<p class="listening-chart-empty help-session-note">No plays with stored genre assignments in {{.Year}}.</p>{{end}}
        <canvas role="img" aria-label="Monthly plays by genre in {{.Year}}, using the server timezone. Each colored band represents one genre."></canvas>
    </div>
    <div class="listening-table visually-hidden">
        <table>
            <caption>{{.Year}} monthly plays by genre</caption>
            <thead><tr><th scope="col">Genre</th>{{range .MonthLabels}}<th scope="col">{{.}}</th>{{end}}</tr></thead>
            <tbody>{{range .Genres}}<tr><th scope="row">{{.Name}}</th>{{range .Counts}}<td>{{if eq . nil}}—{{else}}{{formatNumber .}}{{end}}</td>{{end}}</tr>{{end}}</tbody>
        </table>
    </div>
    {{end}}
    <p class="help-session-note">Each play counts toward every assigned genre; stacked totals may exceed unique plays. Plays without a remaining genre assignment are excluded. {{if .YearToDate}}The current month is incomplete.{{end}}</p>
</section>
{{end}}
