{{define "title"}}Help{{end}}
{{define "body"}}
<body class="config-document">
    <main class="config-standalone" up-main>
        <nav aria-label="Configuration navigation"><a href="{{.URLs.Home}}">Back to Home</a></nav>
        {{template "page-content" .}}
    </main>
</body>
{{end}}
{{define "page-content"}}
<article class="config-page help-page">
    {{template "page-header" .}}
    <section class="help-session" aria-labelledby="session-heading">
        <header class="help-session-header">
            <div>
                <h2 id="session-heading">Browser session</h2>
                <p>Your current sign-in details.</p>
            </div>
            <span class="help-session-status">Authenticated</span>
        </header>
        <div class="help-session-remaining">
            <p class="help-detail-label">Time remaining</p>
            <p class="help-remaining-value">{{.Remaining}}</p>
            <p class="help-session-note">Calculated when this page was loaded.</p>
        </div>
        <dl class="help-session-details">
            <div>
                <dt>Logged in</dt>
                <dd><time datetime="{{.IssuedAt}}">{{formatTimestamp .IssuedAt}}</time></dd>
            </div>
            <div>
                <dt>Expires</dt>
                <dd><time datetime="{{.ExpiresAt}}">{{formatTimestamp .ExpiresAt}}</time></dd>
            </div>
            <div class="help-user-agent">
                <dt>Current user agent</dt>
                <dd>{{.UserAgent}}</dd>
            </div>
        </dl>
        <footer class="help-session-footer">
            <p>Logging out clears this browser’s cookie; copies of the token remain valid until the expiry shown above.</p>
            <form method="post" action="{{.URLs.Logout}}" up-submit>
                <button type="submit" class="action-button">Log out</button>
            </form>
        </footer>
    </section>
    <section class="help-config" aria-labelledby="runtime-config-heading">
        <header class="help-session-header">
            <div>
                <h2 id="runtime-config-heading">Runtime configuration</h2>
                <p>Loaded settings, including defaults and configured roots. Read-only; editing the configuration file requires a server restart to take effect.</p>
            </div>
        </header>
        {{range .Configuration}}
        <details class="help-config-section">
            <summary>{{.Title}}</summary>
            <dl class="help-config-fields">
                {{range .Fields}}
                <div>
                    <dt>{{.Label}}</dt>
                    <dd>
                        {{if eq .Kind "list"}}
                            {{if .Items}}
                            <ul class="help-config-list">
                                {{range .Items}}<li><code>{{.}}</code></li>{{end}}
                            </ul>
                            {{else}}None{{end}}
                        {{else if eq .Kind "map"}}
                            {{if .Entries}}
                            <table class="help-config-table">
                                <caption>{{.Label}}</caption>
                                <thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
                                <tbody>
                                    {{range .Entries}}<tr><th scope="row">{{.Key}}</th><td>{{.Value}}</td></tr>{{end}}
                                </tbody>
                            </table>
                            {{else}}None{{end}}
                        {{else}}
                            {{.Value}}
                        {{end}}
                    </dd>
                </div>
                {{else}}<div><dt>Roots</dt><dd>None configured</dd></div>{{end}}
            </dl>
        </details>
        {{end}}
    </section>
</article>
{{end}}
