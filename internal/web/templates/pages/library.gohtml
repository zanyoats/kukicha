{{define "title"}}Library{{end}}

{{define "page-content"}}
<article class="library-page">
    <div class="library-header">
        {{template "page-header" .}}

        <button
            type="button"
            class="library-sort-trigger"
            aria-haspopup="dialog"
            up-follow
            up-layer="new popup"
            up-content="#library-sort-options"
            up-class="library-sort-popup"
            up-position="bottom"
            up-align="right"
            up-history="false"
            up-dismissible="key outside"
            up-focus=".library-sort-option[data-current]"
        >
            Sort: <strong>{{range .SortOptions}}{{if .Current}}{{.Label}}{{end}}{{end}}</strong>
            <svg class="sort-chevron" aria-hidden="true" focusable="false"><use href="#icon-chevron-down"></use></svg>
        </button>
    </div>

    <template id="library-sort-options">
        <nav class="library-sort-menu" aria-label="Sort albums">
            {{range .SortOptions}}
            <a class="library-sort-option" href="{{.URL}}" {{if .Current}}data-current="true" aria-label="{{.Label}} (current sort)"{{end}}
                up-follow up-layer="root" up-target="[up-main]" up-history="true">{{.Label}}</a>
            {{end}}
        </nav>
    </template>

    <ul class="item-grid">
        {{range .Albums}}
        <li class="album-card" style="--artwork-height: {{.SmallArtwork.Height}}px;">
            <a class="album-card-artwork-link" href="{{.AlbumURL}}" up-follow>
                <img
                    class="album-card-artwork"
                    data-artwork-fallback-url="{{$.URLs.AlbumArtwork64Fallback}}"
                    src="{{.SmallArtwork.URL}}"
                    alt="Artwork for {{.Title}}"
                    width="{{.SmallArtwork.Width}}"
                    height="{{.SmallArtwork.Height}}"
                    loading="lazy"
                />
            </a>

            <div class="album-card-details">
                <h2 class="album-card-title text-truncate" title="{{.Title}}"><a href="{{.AlbumURL}}" up-follow>{{.Title}}</a></h2>

                {{with .Artists}}
                <p class="album-card-artists">
                    {{range $index, $artist := .}}{{if $index}}, {{end}}<a href="{{$artist.URL}}" up-follow>{{$artist.Name}}</a>{{end}}
                </p>
                {{end}}
            </div>
        </li>
        {{else}}
        <li class="item-grid-empty">{{if .FirstURL}}No albums on this page.{{else}}No albums found.{{end}}</li>
        {{end}}
    </ul>

    {{if or .PreviousURL .NextURL .FirstURL}}
    <nav class="library-pagination" aria-label="Album pages">
        {{with .PreviousURL}}<a href="{{.}}" rel="prev" up-follow up-target="[up-main]" up-history="true">Previous</a>{{end}}
        {{with .FirstURL}}<a href="{{.}}" up-follow up-target="[up-main]" up-history="true">Return to first page</a>{{end}}
        {{with .NextURL}}<a href="{{.}}" rel="next" up-follow up-target="[up-main]" up-history="true">Next</a>{{end}}
    </nav>
    {{end}}
</article>
{{end}}
