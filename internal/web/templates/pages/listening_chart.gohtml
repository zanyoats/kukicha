{{define "layout"}}
<section id="listening-chart" aria-label="Monthly scrobbles">
    <h2>Monthly scrobbles</h2>
    {{if .Error}}
    <div class="listening-canvas">
        <p role="alert">{{.Error}}</p>
        <a href="{{.ChartURL}}" up-target="#listening-chart" up-history="false">Retry</a>
    </div>
    {{else}}
    <div class="listening-canvas" data-listening-chart up-data="{{.ChartData}}" aria-busy="true">
        <p class="listening-chart-loading" role="status">Loading chart…</p>
        <canvas role="img" aria-label="Monthly scrobbles for {{.Year}} and {{.PreviousYear}}."></canvas>
    </div>
    <div class="listening-table visually-hidden">
        <table>
            <caption>Scrobbles by month ({{.Timezone}})</caption>
            <thead><tr><th scope="col">Month</th><th scope="col">{{.Year}}</th><th scope="col">{{.PreviousYear}}</th></tr></thead>
            <tbody>{{range .Months}}<tr><th scope="row">{{.Name}}</th><td>{{.Current}}</td><td>{{.Previous}}</td></tr>{{end}}</tbody>
        </table>
    </div>
    {{end}}
</section>
{{end}}
