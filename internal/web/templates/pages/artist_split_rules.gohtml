{{define "title"}}Artist Split Rules{{end}}

{{define "body"}}
<body class="config-document">
    <main class="config-standalone" up-main>
        <nav aria-label="Configuration navigation">
            <a href="{{.URLs.Home}}">Back to Home</a>
        </nav>
        {{template "page-content" .}}
    </main>
</body>
{{end}}

{{define "page-content"}}
<article class="config-page">
    {{template "page-header" .}}
    {{if .Rules}}
    <aside class="alert alert-info" aria-label="Info">
        <strong>Info</strong>
        <p>
            Changes apply on the next scan.
            You can run scan by clicking <button type="button" class="inline-action" disabled title="Scan is not available yet">Scan</button>.
        </p>
    </aside>
    {{end}}
    <div class="split-rules-grid">
        {{range $index, $rule := .Rules}}
        <section class="split-rule" data-split-rule up-data="{{.EditorData}}" aria-labelledby="split-album-{{$index}}">
            <img class="split-rule-cover" src="{{.ArtworkURL}}" alt="" width="32" loading="lazy" />
            <h2 class="split-rule-title" id="split-album-{{$index}}" title="{{.AlbumTitle}}">{{.AlbumTitle}}</h2>
            <ul class="split-rule-artists" data-split-artists>
                {{range .MappedArtists}}<li class="text-truncate" title="{{.}}">{{.}}</li>{{end}}
            </ul>
            <button type="button" data-split-edit aria-controls="split-form-{{$index}}" aria-expanded="false">Edit</button>
            <form class="split-rule-form" id="split-form-{{$index}}" data-split-form hidden>
                <fieldset>
                    <label for="split-artists-{{$index}}">Mapped artists (one per line)</label>
                    <textarea id="split-artists-{{$index}}" rows="3" required aria-describedby="split-error-{{$index}}"></textarea>
                    <div class="split-rule-actions">
                        <button type="submit">Save</button>
                        <button type="button" data-split-cancel>Cancel</button>
                    </div>
                </fieldset>
                <p class="alert alert-error split-rule-error" id="split-error-{{$index}}" role="alert" hidden></p>
            </form>
        </section>
        {{else}}
        <p>No artist splitting is needed. Your album artists don’t match any of the tokens configured in <code>scan.album_artist_split_tokens</code>, so no split rules are required.</p>
        {{end}}
    </div>
</article>
{{end}}
