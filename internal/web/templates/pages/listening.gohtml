{{define "title"}}Listening Data{{end}}
{{define "body"}}
<body class="config-document">
    <main class="config-standalone" up-main>
        <nav aria-label="Navigation"><a href="{{.URLs.Home}}">Back to Home</a></nav>
        {{template "page-content" .}}
    </main>
</body>
{{end}}
{{define "page-content"}}
<article class="config-page listening-page" data-listening-url="{{.PageURL}}">
    {{template "page-header" .}}
    <form class="listening-period help-session-note" action="{{.URLs.ListeningData}}" method="get" up-submit up-autosubmit up-watch-event="change" up-watch-delay="0" up-target=".listening-page" up-history="true">
        {{if .TimezoneParam}}<input type="hidden" name="tz" value="{{.TimezoneParam}}">{{end}}
        <select name="year" aria-label="Listening year">
            {{range .Years}}<option value="{{.}}" {{if eq . $.Year}}selected{{end}}>{{.}}</option>{{end}}
        </select>
        <span>{{if .YearToDate}}year to date · compared with the same period in{{else}}full year · compared with{{end}} {{.PreviousYear}} · {{if .TimezoneParam}}Timezone{{else}}Server timezone{{end}}: {{.Timezone}}</span>
    </form>
    <div class="listening-columns">
        <section id="listening-summary" up-defer up-href="{{.SummaryURL}}" aria-label="Listening statistics">
            <p role="status">Loading listening statistics…</p>
            <a href="{{.SummaryURL}}" up-target="#listening-summary" up-history="false">Load statistics</a>
        </section>
        <section id="listening-hours" up-defer up-href="{{.HoursURL}}" aria-label="Scrobbles by hour">
            <h2>Scrobbles by hour</h2>
            <div class="listening-canvas">
                <p role="status">Loading hourly scrobbles…</p>
                <a href="{{.HoursURL}}" up-target="#listening-hours" up-history="false">Load hourly chart</a>
            </div>
        </section>
        <section id="listening-chart" up-defer up-href="{{.ChartURL}}" aria-label="Monthly scrobbles">
            <h2>Monthly scrobbles</h2>
            <div class="listening-canvas">
                <p role="status">Loading monthly scrobbles…</p>
                <a href="{{.ChartURL}}" up-target="#listening-chart" up-history="false">Load chart</a>
            </div>
        </section>
    </div>
    <section id="listening-genres" up-defer up-href="{{.GenresURL}}" aria-label="Monthly plays by genre">
        <h2>Plays by genre</h2>
        <div class="listening-canvas listening-genres-canvas">
            <p role="status">Loading plays by genre…</p>
            <a href="{{.GenresURL}}" up-target="#listening-genres" up-history="false">Load genre chart</a>
        </div>
        <p class="help-session-note">Each play counts toward every assigned genre; stacked totals may exceed unique plays. Plays without a remaining genre assignment are excluded. {{if .YearToDate}}The current month is incomplete.{{end}}</p>
    </section>
    <p class="help-session-note">Listening time counts each scrobble as a full play using the track’s current duration; unavailable tracks contribute only to scrobble counts. Daily averages include days with no plays{{if .YearToDate}} and today{{end}}. {{if .YearToDate}}The current month is incomplete.{{end}}</p>
</article>
{{end}}
