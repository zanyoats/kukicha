{{define "title"}}Roots{{end}}

{{define "body"}}
<body class="config-document">
    <main class="config-standalone" up-main>
        <nav aria-label="Configuration navigation">
            <a href="{{.URLs.Home}}">Back to Home</a>
        </nav>
        {{template "page-content" .}}
    </main>
</body>
{{end}}

{{define "page-content"}}
<article class="config-page">
    {{template "page-header" .}}
    {{if .ConfiguredRoots}}
    <aside class="alert alert-info" aria-label="Info">
        <strong>Info</strong>
        <p>
            Run <span class="action-with-info"><button type="button" class="inline-action" data-library-job-submit="{{.URLs.SubmitJob}}">Rebuild</button>{{template "job-help-trigger" "rebuild"}}</span> to apply your latest organization rules to saved metadata.
            Use <a href="{{.URLs.Add}}" up-layer="new modal" up-target=".config-page" up-class="config-modal" up-history="false">Add to Kukicha</a> to import music.
        </p>
    </aside>
    {{template "rebuild-job-help" .}}
    {{end}}
    {{range $index, $root := .ConfiguredRoots}}
    <section class="root-summary" aria-labelledby="root-path-{{$index}}">
        <h2 id="root-path-{{$index}}">
            {{.RootKey -}}
            <button
                type="button"
                class="info-trigger"
                aria-label="Details for {{.RootKey}}"
                aria-haspopup="dialog"
                up-follow
                up-layer="new popup"
                up-content="#root-info-{{$index}}"
                up-class="info-popup"
                up-position="bottom"
                up-align="left"
                up-history="false"
                up-dismissible="key outside"
            >
                <span aria-hidden="true">[?]</span>
            </button>
        </h2>
        <template id="root-info-{{$index}}">
            <dl class="root-details">
                <dt>Location</dt>
                <dd>{{.Location}}</dd>
                <dt>Type</dt>
                <dd>{{.Type}}</dd>
                {{with index $.RootsByKey .RootKey}}
                <dt>State</dt>
                <dd>{{.State}}</dd>
                {{end}}
            </dl>
        </template>
        <dl class="facts facts-grid">
            {{with index $.RootsByKey .RootKey}}
            <div>
                <dt>Tracks</dt>
                <dd>{{formatNumber .Tracks}}</dd>
            </div>
            <div>
                <dt>Albums</dt>
                <dd>{{formatNumber .Albums}}</dd>
            </div>
            <div>
                <dt>Playlists</dt>
                <dd>{{formatNumber .Playlists}}</dd>
            </div>
            <div>
                <dt>Album sidecars</dt>
                <dd>{{formatNumber .AlbumSidecars}}</dd>
            </div>
            {{end}}
        </dl>
        {{if not (index $.RootsByKey .RootKey)}}
        <p class="text-secondary">No data found for this root.</p>
        {{end}}
    </section>
    {{else}}
    <p>No music roots are configured. Add roots to your config.</p>
    {{end}}

    {{if .LostRoots}}
    <aside class="alert alert-warning lost-roots" aria-labelledby="lost-roots-heading">
        <strong id="lost-roots-heading">Lost roots — no longer configured</strong>
        <p>These roots are missing from your current configuration. Their saved music is retained but hidden from the library.</p>
        <p>Drop a root to remove its saved library data during the next build. Files in storage are left untouched.</p>
        <ul class="lost-root-list">
            {{range .LostRoots}}
            <li data-lost-root>
                <code class="text-truncate" title="{{.ConfigID}}">{{.ConfigID}}</code>
                <span class="action-with-info">
                    <button type="button" class="inline-action" data-drop-root="{{$.URLs.DropRoot}}"
                        data-root-id="{{.ConfigID}}" aria-label="Drop root {{.ConfigID}}">Drop</button>
                    <button type="button" class="info-trigger" aria-label="What happens when you drop a root"
                        aria-haspopup="dialog" up-follow up-layer="new popup" up-content="#drop-root-help"
                        up-class="info-popup" up-position="bottom" up-align="left"
                        up-history="false" up-dismissible="key outside"><span aria-hidden="true">[?]</span></button>
                </span>
            </li>
            {{end}}
        </ul>
        <template id="drop-root-help">
            <section class="job-help" aria-labelledby="drop-root-help-title">
                <h2 id="drop-root-help-title">What does Drop do?</h2>
                <p>Drop removes this root from the list now. Its saved library information is deleted during the next build.</p>
                <p><strong>Your files are never deleted</strong>, and Drop won’t start a build.</p>
                <p class="job-help-note">If a build is already running, wait for it to finish before dropping a root.</p>
            </section>
        </template>
    </aside>
    {{end}}

    {{if .LatestBuildID}}
    <section class="root-summary">
        <a href="{{.URLs.JobLogsURL .LatestBuildID 0}}" up-layer="new modal"
            up-target="#job-logs-page" up-class="config-modal" up-history="false"
            up-animation="false" up-close-animation="false" up-cache="false">View logs for latest library build</a>
    </section>
    {{else}}
    <p>No completed library build available.</p>
    {{end}}
</article>
{{end}}
