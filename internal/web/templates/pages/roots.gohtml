{{define "title"}}Roots{{end}}

{{define "body"}}
<body class="config-document">
    <main class="config-standalone" up-main>
        <nav aria-label="Configuration navigation">
            <a href="{{.URLs.Home}}">Back to Home</a>
        </nav>
        {{template "page-content" .}}
    </main>
</body>
{{end}}

{{define "page-content"}}
<article class="config-page">
    {{template "page-header" .}}
    {{if .ConfiguredRoots}}
    <aside class="alert alert-info" aria-label="Info">
        <strong>Info</strong>
        <p>
            Configured roots are synced at startup.
            You can run <span class="action-with-info"><button type="button" class="inline-action" data-library-job-submit="{{.URLs.SubmitJob}}" data-job-type="scan">Scan</button>{{template "job-help-trigger" "scan"}}</span> to rebuild the library,
            or <span class="action-with-info"><button type="button" class="inline-action" data-library-job-submit="{{.URLs.SubmitJob}}" data-job-type="sync">Sync</button>{{template "job-help-trigger" "sync"}}</span> to also re-download all files.
            Either option starts a new job that runs in the background.
            For a full factory reset, use <span class="action-with-info"><button type="button" class="inline-action" data-library-job-submit="{{.URLs.SubmitJob}}" data-job-type="reset">Reset</button>{{template "job-help-trigger" "reset"}}</span>,
            which removes split rules, cached resources, and other jobs before running a full sync.
        </p>
    </aside>
    {{template "scan-job-help" .}}
    {{template "sync-job-help" .}}
    {{template "reset-job-help" .}}
    {{end}}
    {{range $index, $root := .ConfiguredRoots}}
    <section class="root-summary" aria-labelledby="root-path-{{$index}}">
        <h2 id="root-path-{{$index}}">
            {{.RootKey -}}
            <button
                type="button"
                class="info-trigger"
                aria-label="Location for {{.RootKey}}"
                aria-haspopup="dialog"
                up-follow
                up-layer="new popup"
                up-content="#root-info-{{$index}}"
                up-class="info-popup"
                up-position="bottom"
                up-align="left"
                up-history="false"
                up-dismissible="key outside"
            >
                <span aria-hidden="true">[?]</span>
            </button>
        </h2>
        <template id="root-info-{{$index}}">
            <p class="root-location">{{.Location}}</p>
        </template>
        <dl class="facts facts-grid">
            <div>
                <dt>Type</dt>
                <dd>{{.Type}}</dd>
            </div>
            {{with index $.RootsByKey .RootKey}}
            <div>
                <dt>Tracks</dt>
                <dd>{{formatNumber .Tracks}}</dd>
            </div>
            <div>
                <dt>Albums</dt>
                <dd>{{formatNumber .Albums}}</dd>
            </div>
            <div>
                <dt>Playlists</dt>
                <dd>{{formatNumber .Playlists}}</dd>
            </div>
            <div>
                <dt>Album sidecars</dt>
                <dd>{{formatNumber .AlbumSidecars}}</dd>
            </div>
            {{end}}
        </dl>
        {{if not (index $.RootsByKey .RootKey)}}
        <p class="text-secondary">No data found for this root.</p>
        {{end}}
    </section>
    {{else}}
    <p>No music roots are configured. Add roots to your config.</p>
    {{end}}

    {{if .LatestSyncID}}
    <section class="root-summary">
        <a href="{{.URLs.JobLogsURL .LatestSyncID 0}}" up-layer="new modal"
            up-target="#job-logs-page" up-class="config-modal" up-history="false"
            up-animation="false" up-close-animation="false" up-cache="false">View logs for latest successful sync</a>
    </section>
    {{else}}
    <p>No successful sync available.</p>
    {{end}}
</article>
{{end}}
