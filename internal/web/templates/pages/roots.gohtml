{{define "title"}}Roots{{end}}

{{define "body"}}
<body class="config-document">
    <main class="config-standalone" up-main>
        <nav aria-label="Configuration navigation">
            <a href="{{.URLs.Home}}">Back to Home</a>
        </nav>
        {{template "page-content" .}}
    </main>
</body>
{{end}}

{{define "page-content"}}
<article class="config-page">
    {{template "page-header" .}}
    {{if .ConfiguredRoots}}
    <aside class="alert alert-info" aria-label="Info" data-sync-job>
        <strong>Info</strong>
        <p>
            Configured roots are synced at startup.
            You can run <button type="button" class="inline-action" disabled title="Scan is not available yet">Scan</button> to rebuild the library,
            or <button type="button" class="inline-action" data-sync-submit="{{.URLs.SubmitJob}}">Sync</button> to also re-download all files.
            Either option starts a new job that runs in the background.
            For a full factory reset, use <button type="button" class="inline-action" disabled title="Reset is not available yet">Reset</button>,
            which runs a sync and removes all listening data.
        </p>
    </aside>
    {{end}}
    {{range $index, $root := .ConfiguredRoots}}
    <section class="root-summary" aria-labelledby="root-path-{{$index}}">
        <h2 id="root-path-{{$index}}">{{.RootPath}}</h2>
        {{with index $.RootsByPath .RootPath}}
        <dl class="facts">
            <div>
                <dt>Tracks</dt>
                <dd>{{formatNumber .Tracks}}</dd>
            </div>
            <div>
                <dt>Albums</dt>
                <dd>{{formatNumber .Albums}}</dd>
            </div>
            <div>
                <dt>Playlists</dt>
                <dd>{{formatNumber .Playlists}}</dd>
            </div>
            <div>
                <dt>Album sidecars</dt>
                <dd>{{formatNumber .AlbumSidecars}}</dd>
            </div>
        </dl>
        {{else}}
        <p class="text-secondary">No data found for this root.</p>
        {{end}}
    </section>
    {{else}}
    <p>No music roots are configured. Add roots to your config.</p>
    {{end}}

    {{if .LatestSyncID}}
    <section class="root-summary">
        <a href="{{.URLs.JobLogsURL .LatestSyncID 0}}" up-layer="new modal"
            up-target="#job-logs-page" up-class="config-modal" up-history="false"
            up-animation="false" up-close-animation="false" up-cache="false">View logs for latest successful sync</a>
    </section>
    {{else}}
    <p>No successful sync available.</p>
    {{end}}
</article>
{{end}}
